# =============================================================================
# Agentic RAG Platform — Environment Configuration
# =============================================================================
# Copy this file to .env and populate the required values.
# Nested settings use __ as the delimiter (e.g. OPENAI__API_KEY maps to
# settings.openai.api_key). Variable names are case-insensitive.
# =============================================================================

# -----------------------------------------------------------------------------
# App Settings
# -----------------------------------------------------------------------------

APP__ENV=dev                        # Optional | dev | staging | prod
APP__DEBUG=false                    # Optional | enable debug mode
APP__APP_NAME=Agentic RAG Platform  # Optional | application display name
APP__VERSION=0.1.0                  # Optional | application version string
APP__LOG_LEVEL=INFO                 # Optional | DEBUG | INFO | WARNING | ERROR | CRITICAL

# -----------------------------------------------------------------------------
# OpenAI Settings
# -----------------------------------------------------------------------------

OPENAI__API_KEY=sk-your-openai-api-key-here  # Required
OPENAI__MODEL_NAME=gpt-4o                    # Optional | LLM model identifier
OPENAI__TEMPERATURE=0.0                      # Optional | sampling temperature (0.0–2.0)
OPENAI__MAX_TOKENS=2048                      # Optional | max tokens per response

# -----------------------------------------------------------------------------
# Pinecone Settings
# -----------------------------------------------------------------------------

PINECONE__API_KEY=pcsk_your-pinecone-api-key-here  # Required
PINECONE__INDEX_NAME=rag-index                     # Optional | target index name
PINECONE__ENVIRONMENT=us-east-1-aws                # Optional | Pinecone cloud region
PINECONE__NAMESPACE=default                        # Optional | index namespace

# -----------------------------------------------------------------------------
# Cohere Settings
# -----------------------------------------------------------------------------

COHERE__API_KEY=your-cohere-api-key-here      # Required
COHERE__RERANK_MODEL=rerank-english-v3.0      # Optional | reranking model name
COHERE__TOP_N=5                               # Optional | results to keep after reranking

# -----------------------------------------------------------------------------
# Qdrant Settings  (optional service — no API key needed for local deployment)
# -----------------------------------------------------------------------------

QDRANT__URL=http://localhost       # Optional | Qdrant server base URL
QDRANT__COLLECTION_NAME=rag-collection  # Optional | vector collection name
QDRANT__PORT=6333                  # Optional | Qdrant server port

# -----------------------------------------------------------------------------
# Redis Settings  (optional service — used for semantic cache)
# -----------------------------------------------------------------------------

REDIS__URL=redis://localhost:6379  # Optional | Redis connection URL
REDIS__TTL_SECONDS=3600            # Optional | cache entry TTL in seconds

# -----------------------------------------------------------------------------
# Chunking Settings
# -----------------------------------------------------------------------------

CHUNKING__CHUNK_SIZE=512           # Optional | target tokens per chunk
CHUNKING__CHUNK_OVERLAP=90         # Optional | token overlap between adjacent chunks
CHUNKING__STRATEGY=fixed           # Optional | fixed | semantic

# -----------------------------------------------------------------------------
# Embedding Settings
# -----------------------------------------------------------------------------

EMBEDDING__PROVIDER=openai                          # Optional | openai | huggingface
EMBEDDING__MODEL_NAME=text-embedding-3-small        # Optional | embedding model identifier
EMBEDDING__BATCH_SIZE=256                           # Optional | texts per API batch call

# -----------------------------------------------------------------------------
# Vector Store Settings
# -----------------------------------------------------------------------------

VECTORSTORE__PROVIDER=pinecone     # Optional | pinecone | qdrant
VECTORSTORE__UPSERT_BATCH_SIZE=100 # Optional | documents per upsert batch

# -----------------------------------------------------------------------------
# Retrieval Settings
# -----------------------------------------------------------------------------

RETRIEVAL__TOP_K=10                # Optional | candidate count before reranking
RETRIEVAL__MODE=hybrid             # Optional | dense | sparse | hybrid
RETRIEVAL__SCORE_THRESHOLD=0.7     # Optional | minimum relevance score (0.0–1.0)
